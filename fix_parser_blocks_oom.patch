+                       static_cast<size_t>(result.header.blocksSize()));
+        } catch (const std::exception& e) {
+            result.blocksData.clear();
+            return toParseError(ErrorCode::OutOfMemory, ParserState::CompressedBlocks, 0);
+        }
+    } else {
